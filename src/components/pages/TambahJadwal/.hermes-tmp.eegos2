import { useState } from 'react';
import { useAppContext } from '../../../context/AppContext';

export function TambahJadwal() {
  const { addVideo } = useAppContext();
  const [series, setSeries] = useState('Wuxia After a Thousand Years of Cultivation');
  const [part, setPart] = useState('86');
  const [subtitle, setSubtitle] = useState('Pertarungan di Puncak Gunung Naga Perak (Bab 340-345)');
  const [date, setDate] = useState('2026-11-20');
  const [time, setTime] = useState('18:00');
  const [category, setCategory] = useState('NOVEL_CHINA');

  const handleSubmit = () => {
    const newVideo = {
      id: `vid-${Date.now()}`,
      no: Math.floor(Math.random() * 1000),
      category: category as 'LIGHT_NOVEL' | 'NOVEL_CHINA' | 'CUSTOM',
      title: `${series} - Part ${part}`,
      subtitle,
      scheduleDate: date,
      scheduleTime: time,
      status: 'PENDING' as const,
      platform: 'YouTube',
    };
    addVideo(newVideo);
    alert('Video jadwal berhasil ditambahkan!');
  };

  return (
    <div className="pl-64">
      <main className="relative pt-10 min-h-screen bg-surface px-space-xl py-space-lg">
        <div className="flex flex-col w-full max-w-[1400px] mx-auto pb-space-2xl">
          {/* Header */}
          <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md bg-surface-container-lowest p-space-lg rounded-xl shadow-sm mb-space-lg">
            <div className="flex items-center gap-space-md">
              <div className="w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center shadow-inner">
                <span className="material-symbols-outlined text-[24px]">calendar_add_on</span>
              </div>
              <div>
                <div className="flex items-center gap-space-xs">
                  <h1 className="font-headline-md text-headline-md text-on-surface">Input Jadwal Video Baru</h1>
                  <span className="px-space-xs py-0.5 rounded text-[11px] font-semibold bg-tertiary/10 text-tertiary uppercase tracking-wide">
                    Mode Cepat
                  </span>
                </div>
                <p className="font-body-sm text-body-sm text-on-surface-variant">
                  Isi data manual atau gunakan Fitur Auto-Increment Part untuk novel berseri tanpa ribet.
                </p>
              </div>
            </div>
          </div>

          {/* Mode Tabs */}
          <div className="flex items-center justify-between bg-surface-container-low p-1.5 rounded-xl mb-space-lg">
            <div className="grid grid-cols-2 gap-1.5 w-full sm:w-auto min-w-[340px]">
              <button className="flex items-center justify-center gap-space-sm py-2 px-space-lg rounded-lg bg-surface-container-lowest text-primary font-label-md text-label-md font-semibold shadow-sm transition-all">
                <span className="material-symbols-outlined text-[18px]">movie</span>
                <span>Input Satu Video</span>
              </button>
              <button className="flex items-center justify-center gap-space-sm py-2 px-space-lg rounded-lg text-on-surface-variant hover:text-on-surface hover:bg-surface-container-highest/60 font-label-md text-label-md transition-all">
                <span className="material-symbols-outlined text-[18px]">dynamic_feed</span>
                <span>Buat Jadwal Beruntun</span>
              </button>
            </div>
          </div>

          {/* Form Grid */}
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
            {/* Form Section */}
            <div className="lg:col-span-7 flex flex-col gap-space-lg">
              {/* Category Selection */}
              <div className="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col gap-space-md">
                <label className="font-title-sm text-title-sm text-on-surface flex items-center gap-space-xs">
                  <span className="material-symbols-outlined text-primary text-[18px]">category</span>
                  1. Pilih Kategori Proyek
                </label>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-space-sm">
                  {[
                    { value: 'LIGHT_NOVEL', label: 'Light Novel', emoji: '📖', sub: 'JP / KR Webnovel' },
                    { value: 'NOVEL_CHINA', label: 'Novel China', emoji: '🐉', sub: 'Xianxia / Wuxia' },
                    { value: 'CUSTOM', label: 'Kustom / Shorts', emoji: '✨', sub: 'Reels, Recap, Clip' },
                  ].map((cat) => (
                    <button
                      key={cat.value}
                      onClick={() => setCategory(cat.value)}
                      className={`flex flex-col items-center justify-center p-space-md rounded-xl font-label-md text-label-md shadow-sm transition-all transform active:scale-95 ${
                        category === cat.value
                          ? 'bg-surface-container text-primary'
                          : 'bg-surface-container-low hover:bg-surface-container text-on-surface'
                      }`}
                    >
                      <span className="text-2xl mb-1">{cat.emoji}</span>
                      <span className="font-semibold text-on-surface">{cat.label}</span>
                      <span className="font-body-sm text-body-sm text-on-surface-variant">{cat.sub}</span>
                    </button>
                  ))}
                </div>
              </div>

              {/* Series & Part */}
              <div className="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col gap-space-md">
                <label className="font-title-sm text-title-sm text-on-surface flex items-center justify-between">
                  <span className="flex items-center gap-space-xs">
                    <span className="material-symbols-outlined text-primary text-[18px]">auto_stories</span>
                    2. Detail Konten & Seri
                  </span>
                </label>

                <div className="flex flex-col gap-space-xs">
                  <span className="font-label-sm text-label-sm text-on-surface-variant font-medium">Judul Seri Utama</span>
                  <input
                    className="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant focus:outline-none focus:bg-surface-container-lowest shadow-inner"
                    placeholder="Ketik atau pilih dari riwayat..."
                    type="text"
                    value={series}
                    onChange={(e) => setSeries(e.target.value)}
                  />
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-12 gap-space-md pt-space-xs items-end">
                  <div className="sm:col-span-4 flex flex-col gap-space-xs">
                    <label className="font-label-sm text-label-sm text-on-surface-variant font-medium">Nomor Part / Chapter</label>
                    <div className="flex items-center gap-space-xs">
                      <span className="px-space-md h-10 rounded-lg bg-surface-container-high font-semibold text-on-surface flex items-center justify-center text-label-md">
                        Part
                      </span>
                      <input
                        className="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-on-surface font-headline-sm text-headline-sm font-semibold focus:outline-none focus:bg-surface-container-lowest text-center shadow-inner"
                        min="1"
                        type="number"
                        value={part}
                        onChange={(e) => setPart(e.target.value)}
                      />
                    </div>
                  </div>

                  <div className="sm:col-span-8 flex flex-col gap-space-xs">
                    <div className="flex items-center justify-between">
                      <span className="font-label-sm text-label-sm text-on-surface-variant font-medium">Smart Detect</span>
                      <span className="font-code-sm text-code-sm text-tertiary flex items-center gap-0.5">
                        <span className="material-symbols-outlined text-[13px]">check_circle</span> Terakhir: Part 85
                      </span>
                    </div>
                    <button
                      onClick={() => setPart(String(parseInt(part) + 1))}
                      className="h-10 px-space-md rounded-lg bg-secondary-container hover:bg-secondary-fixed text-on-secondary-container font-label-md text-label-md flex items-center justify-center gap-space-xs transition-all shadow-sm"
                    >
                      <span className="material-symbols-outlined text-[18px]">bolt</span>
                      <span>⚡ Auto-isi Part Selanjutnya ({parseInt(part) + 1})</span>
                    </button>
                  </div>
                </div>

                <div className="flex flex-col gap-space-xs">
                  <label className="font-label-sm text-label-sm text-on-surface-variant font-medium">Subjudul Episode</label>
                  <input
                    className="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant focus:outline-none focus:bg-surface-container-lowest shadow-inner"
                    placeholder="Contoh: Bab 120-125 | Menembus Alam Surgawi..."
                    type="text"
                    value={subtitle}
                    onChange={(e) => setSubtitle(e.target.value)}
                  />
                </div>
              </div>

              {/* Date & Time */}
              <div className="bg-surface-container-lowest p-space-lg rounded-xl shadow-sm flex flex-col gap-space-md">
                <label className="font-title-sm text-title-sm text-on-surface flex items-center justify-between">
                  <span className="flex items-center gap-space-xs">
                    <span className="material-symbols-outlined text-primary text-[18px]">schedule</span>
                    3. Tanggal & Jam Tayang
                  </span>
                </label>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
                  <div className="flex flex-col gap-space-xs">
                    <span className="font-label-sm text-label-sm text-on-surface-variant">Tanggal Publikasi</span>
                    <input
                      className="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest shadow-inner"
                      type="date"
                      value={date}
                      onChange={(e) => setDate(e.target.value)}
                    />
                  </div>
                  <div className="flex flex-col gap-space-xs">
                    <span className="font-label-sm text-label-sm text-on-surface-variant">Jam Upload</span>
                    <input
                      className="w-full h-10 px-space-md bg-surface-container-low rounded-lg text-on-surface font-body-md text-body-md focus:outline-none focus:bg-surface-container-lowest shadow-inner"
                      type="time"
                      value={time}
                      onChange={(e) => setTime(e.target.value)}
                    />
                  </div>
                </div>

                <div className="flex flex-col gap-space-xs">
                  <span className="font-label-sm text-label-sm text-on-surface-variant">Preset Jam Tayang:</span>
                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-space-xs">
                    {['00:00', '06:00', '12:00', '18:00'].map((t) => (
                      <button
                        key={t}
                        onClick={() => setTime(t)}
                        className={`py-2 px-space-xs rounded-lg font-label-md text-label-md flex flex-col items-center justify-center transition-colors ${
                          time === t
                            ? 'bg-primary text-on-primary shadow-sm'
                            : 'bg-surface-container hover:bg-surface-container-high text-on-surface'
                        }`}
                      >
                        <span className="font-semibold">{t}</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* Preview Section */}
            <div className="lg:col-span-5 flex flex-col gap-space-lg lg:sticky lg:top-14">
              <div className="flex items-center justify-between px-space-sm">
                <span className="font-title-sm text-title-sm text-on-surface flex items-center gap-space-xs">
                  <span className="material-symbols-outlined text-primary text-[20px]">preview</span>
                  Live Preview
                </span>
              </div>

              <div className="bg-surface-container-lowest rounded-xl overflow-hidden shadow-md flex flex-col">
                <div className="relative w-full aspect-video bg-surface-container-highest flex items-center justify-center">
                  <span className="material-symbols-outlined text-[64px] text-on-surface-variant opacity-30">image</span>
                </div>

                <div className="p-space-lg flex flex-col gap-space-sm">
                  <div className="flex items-center gap-space-xs">
                    <span className={`px-2 py-0.5 rounded text-[11px] font-semibold text-${category === 'NOVEL_CHINA' ? 'secondary' : 'primary'}`}>
                      {category}
                    </span>
                  </div>

                  <h3 className="font-title-md text-title-md text-on-surface font-semibold line-clamp-2">
                    {series} - Part {part}
                    {subtitle && ` : ${subtitle}`}
                  </h3>

                  <div className="flex items-center justify-between text-on-surface-variant text-body-sm">
                    <span>
                      {date} {time} WIB
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Footer Actions */}
          <div className="sticky bottom-4 z-30 bg-surface-container-highest/95 backdrop-blur-md p-space-md rounded-xl shadow-lg flex flex-col sm:flex-row items-center justify-between gap-space-md mt-space-xl">
            <button className="h-10 px-space-lg rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-md text-label-md transition-colors flex items-center justify-center gap-space-xs">
              <span className="material-symbols-outlined text-[18px]">close</span>
              <span>Batal</span>
            </button>

            <div className="flex items-center gap-space-sm w-full sm:w-auto justify-end">
              <button className="flex-1 sm:flex-none h-10 px-space-lg rounded-lg bg-surface-container-lowest hover:bg-surface-container text-on-surface font-label-md text-label-md transition-colors shadow-sm flex items-center justify-center gap-space-xs">
                <span className="material-symbols-outlined text-[18px]">add</span>
                <span>Simpan & Tambah Lagi</span>
              </button>
              <button
                onClick={handleSubmit}
                className="flex-1 sm:flex-none h-10 px-space-xl rounded-lg bg-primary hover:bg-primary-container text-on-primary font-label-md text-label-md font-semibold transition-all shadow-md active:scale-95 flex items-center justify-center gap-space-xs"
              >
                <span className="material-symbols-outlined text-[20px]">save</span>
                <span>Simpan Jadwal</span>
              </button>
            </div>
          </div>
        </div>
      </main>
    </div>
  );
}
